#! /bin/sh

name=libgpg-error
version=1.54
revision=1
tarball_url="https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-${version}.tar.gz"
tarball_blake2b="4d2528bcf7f16035b6e97d5756a5b0eb95f8fce431cfd841a69fcec2237d067a1fa832a6a42da40c3d8afc048749854917834ffbafd66dfeb77d9aa4822f48c1"
source_hostdeps="automake autoconf libtool pkg-config"
imagedeps="build-essential"
hostdeps="gcc pkg-config"
deps="core-libs readline"

prepare() {
    autotools_recursive_regen

    # libgpg-error does not know about mlibc, teach it
    cp -v ${source_dir}/src/syscfg/lock-obj-pub.x86_64-unknown-linux-gnu.h \
        ${source_dir}/src/syscfg/lock-obj-pub.linux-mlibc.h
}

configure() {
    autotools_configure \
        --enable-threads \
        --enable-install-gpg-error-config
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
