#! /bin/sh

name=libxkbcommon
version=1.8.1
revision=1
git_url="https://github.com/xkbcommon/libxkbcommon.git"
commit=b3465081878e80ca6c11fe35c81787ec374ec15a
imagedeps="build-essential git meson ninja-build libwayland-bin pkg-config"
hostdeps="gcc pkg-config"
deps="core-libs libxcb libxml xkeyboard-config wayland wayland-protocols"

configure() {
    meson_configure \
        -Dxkb-config-root="$prefix"/share/X11/xkb
}

build() {
    ninja -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" ninja install

    mkdir -p "${dest_dir}${prefix}/share/X11/xkb"
    touch "${dest_dir}${prefix}/share/X11/xkb/.keep"

    post_package_strip
}
