#! /bin/sh

name=gsettings-desktop-schemas
version=48.0
revision=1
tarball_url="https://download.gnome.org/sources/gsettings-desktop-schemas/48/gsettings-desktop-schemas-${version}.tar.xz"
tarball_blake2b="b65b7c2e5c1951623b07cbe6e5c7b39c8dd5ccf222bcac18a1fb5b92d21ce072ffe51d89202b173394ece4dcd23ad1936b844c39fc76facaf1f704583a0603bd"
imagedeps="build-essential meson ninja-build python3 patchelf"
hostdeps="gcc pkg-config gobject-introspection glib"
deps="core-libs glib gobject-introspection glib-gi"

prepare() {
    sed -i -r 's:"(/system):"/org/gnome\1:g' schemas/*.in
}

configure() {
    meson_configure \
        -Dintrospection=true
}

build() {
    gi_env ninja -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" ninja install

    post_package_strip
}
