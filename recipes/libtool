#! /bin/sh

name=libtool
version=2.4.7
revision=1
from_source=libtool
hostdeps="gcc autoconf automake libtool pkg-config"
deps="core-libs"

configure() {
    cp -rp "${source_dir}"/. ./

        configure_script_path=./configure \
	autotools_configure
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}