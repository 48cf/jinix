#! /bin/sh

name=harfbuzz
version=11.4.5
revision=1
git_url="https://github.com/harfbuzz/harfbuzz.git"
commit=22f77d48abc35c1e053d02f1ada0d8f1ce1b8423
imagedeps="build-essential patchelf"
hostdeps="gcc pkg-config gobject-introspection glib2"
deps="core-libs graphite2 glib2 gobject-introspection zlib freetype2 cairo icu"

configure() {
    meson_configure \
        -Dgraphite2=enabled \
        -Dglib=enabled \
        -Dgobject=enabled \
        -Dicu=enabled \
        -Dfreetype=enabled \
        -Dcairo=enabled \
        -Dtests=disabled \
        -Dintrospection=enabled
}

build() {
    gi_env meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
