#! /bin/sh

name=mesa
version=25.0.4
revision=1
tarball_url="https://archive.mesa3d.org/mesa-${version}.tar.xz"
tarball_blake2b="b661bc1534bff848c32c559ecc790fd7770682aa7f35403c2fb50b899ad83dbbafb2baecf0e372972849378a4a539eeafe5e9c9e1497ab4313ebcafa89f6e248"
imagedeps="meson ninja-build python3-mako python3-yaml glslang-tools libwayland-bin pkg-config"
hostdeps="gcc pkg-config"
deps="core-libs libdrm libexpat libglvnd libx11 libxcb libxext libxfixes libxrandr libxshmfence libxxf86vm llvm systemd wayland-protocols xcb-util-keysyms zlib zstd"

configure() {
    meson_configure \
        -Db_ndebug=true \
        -Dbuild-tests=false \
        -Dshared-glapi=enabled \
        -Dexpat=enabled \
        -Dgbm=enabled \
        -Dgles1=enabled \
        -Dgles2=enabled \
        -Dglvnd=enabled \
        -Degl=enabled \
        -Dllvm=enabled \
        -Dzstd=enabled \
        -Dosmesa=true \
        -Dvideo-codecs=all_free \
        -Dvulkan-drivers=amd,swrast,virtio \
        -Dvulkan-layers=device-select,intel-nullhw,overlay \
        -Dgallium-drivers=r300,r600,nouveau,virgl,svga,i915,crocus,zink,softpipe,llvmpipe \
        -Dgallium-extra-hud=true \
        -Dgallium-rusticl=false
}

build() {
    ninja -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" ninja install

    post_package_strip
}
